<Project Sdk="Microsoft.NET.Sdk">

	<!-- General Package Properties -->
	<PropertyGroup>
		<PackageId>Rephysicalized</PackageId>
		<Version>1.0.0</Version>
		<Authors>MitBoy</Authors>
		<Copyright>$(AssemblyCopyright)</Copyright>
		<RepositoryUrl>https://github.com/MitBoy42/ONI-Rephysicalized</RepositoryUrl>
	</PropertyGroup>

	<!-- Build Properties -->
	<PropertyGroup>
		<Configurations>Debug;Release</Configurations>
		<AssemblyName>Rephysicalized</AssemblyName>
		<RootNamespace>Rephysicalized</RootNamespace>
		<IsMod>true</IsMod>
		<GenerateMetadata>true</GenerateMetadata>
		<IsPacked>true</IsPacked>
	</PropertyGroup>


	<!-- Mod Info -->
	<PropertyGroup>
		<ModName>Rephysicalized</ModName>
		<ModDescription></ModDescription>
		<MinimumSupportedBuild>$(TargetGameVersion)</MinimumSupportedBuild>
		<APIVersion>2</APIVersion>
	</PropertyGroup>


	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<OutDir>bin</OutDir>
	</PropertyGroup>

		<PropertyGroup>
		<LangVersion>preview</LangVersion>
		<ImplicitUsings>disable</ImplicitUsings>
	</PropertyGroup>

		<ItemGroup>
		  <Compile Remove="Content\ModDb\**" />
		  <Compile Remove="Content\System Patches\**" />
		  <EmbeddedResource Remove="Content\ModDb\**" />
		  <EmbeddedResource Remove="Content\System Patches\**" />
		  <None Remove="Content\ModDb\**" />
		  <None Remove="Content\System Patches\**" />
		</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\UtilLibs\UtilLibs.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <RefAssemblies Remove="Content\System Patches\**" />
	</ItemGroup>

	<ItemGroup>
	  <RefAssemblies Remove="Content\ModDb\**" />
	</ItemGroup>

